      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;a href=&#34;https://secopssleuth.github.io/notes/tools/#oneclickevict&#34;&gt;OneClickEvict&lt;/a&gt;&lt;/td&gt;
          &lt;td&gt;Contain, remediate, and restore compromised Microsoft Entra ID accounts&lt;/td&gt;
          &lt;td&gt;&lt;em&gt;Private&lt;/em&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;a href=&#34;https://secopssleuth.github.io/notes/tools/#pyhuntkql&#34;&gt;PyHuntKQL&lt;/a&gt;&lt;/td&gt;
          &lt;td&gt;Python-powered threat hunting with KQL superpowers&lt;/td&gt;
          &lt;td&gt;&lt;em&gt;Private&lt;/em&gt;&lt;/td&gt;
      &lt;/tr&gt;
  &lt;/tbody&gt;
